parameters:
    paths:
        - src
    # these use optional packages (maatwebsite/excel, spatie/eloquent-sortable) that are only suggested
    excludePaths:
        - src/Grid/Exporters/ExcelExporter.php
        - src/Widgets/Grid/Exporters/ExcelExporter.php
        - src/SortableModel.php
    level: 6
    # inline @phpstan-ignore comments written before phpstan ran in CI; some no longer match
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Call to static method user\(\) on an unknown class Exment.#'
        - '#Call to static method transaction\(\) on an unknown class ExmentDB.#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id.#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$password.#'
        - '#Call to an undefined method ExmentAdminCore\\Admin\\Grid\\Column::pluck\(\).#'
        - '#Cannot call method with\(\) on string.#'
        - '#Cannot call method render\(\) on string.#'
        - '#Return type \(Illuminate\\Contracts\\View\\Factory\|Illuminate\\View\\View\) of method ExmentAdminCore\\Admin\\Widgets\\Grid\\Tools\\QuickSearch::render\(\) should be compatible with return type \(string\) of method ExmentAdminCore\\Admin\\Widgets\\Grid\\Tools\\AbstractTool::render\(\)#'
        - '#Return type \(Illuminate\\Contracts\\View\\Factory\|Illuminate\\View\\View\) of method ExmentAdminCore\\Admin\\Widgets\\Grid\\Tools\\QuickSearch::render\(\) should be compatible with return type \(string\) of method Illuminate\\Contracts\\Support\\Renderable::render\(\)#'
        - '#Instanceof between Illuminate\\Database\\Eloquent\\Relations\\Relation and Illuminate\\Database\\Eloquent\\Relations\\MorphToMany will always evaluate to false.#'
        - '#Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany does not specify its types#'
        - '#Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types#'

includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
