{
    "name": "exceedone/exment-admin-core",
    "description": "exment-admin-core. Open-source Laravel Admin panel used by Exment. No pro or paid package, free & open. Based on open-admin-core (dedermus) and laravel-admin, with special thanks to z-song",
    "type": "library",
    "keywords": ["laravel", "admin", "grid", "form", "exment", "open-admin","open","free"],
    "homepage": "https://github.com/exceedone/exment-admin-core",
    "license": "MIT",
    "authors": [
      {
        "name": "Exceedone",
        "role": "Maintainer"
      },
      {
        "name": "dedermus",
        "email": "dedermus@yandex.ru",
        "role": "Original author (open-admin-core)"
      }
    ],
    "require": {
      "php": "^8.2",
      "symfony/dom-crawler": "~3.1|~4.0|~5.0|~7.1",
      "laravel/framework": ">=7.0",
      "doctrine/dbal": "^4.1"
    },
    "require-dev": {
      "laravel/laravel": "^12",
      "fzaninotto/faker": "~1.4",
      "intervention/image": "~2.3",
      "laravel/browser-kit-testing": "^6.0",
      "spatie/phpunit-watcher": "^1.22.0"
    },
    "autoload": {
      "psr-4": {
        "ExmentAdminCore\\Admin\\": "src/"
      },
      "files": [
        "src/helpers.php"
      ]
    },
    "autoload-dev": {
      "psr-4": {
        "Tests\\Models\\": "tests/models",
        "Tests\\Controllers\\": "tests/controllers"
      },
      "classmap": [
        "tests/TestCase.php"
      ]
    },
    "scripts": {
      "sass": "sass --watch resources/assets/open-admin/scss/styles.scss:resources/assets/open-admin/css/styles.css resources/assets/open-admin/scss/pages:resources/assets/open-admin/css/pages --style compressed",
      "test": "./vendor/bin/phpunit"
    },
    "suggest": {
      "intervention/image": "Required to handling and manipulation upload images (~2.3).",
      "spatie/eloquent-sortable": "Required to built orderable gird."
    },
    "extra": {
      "laravel": {
        "providers": [
          "ExmentAdminCore\\Admin\\AdminServiceProvider"
        ],
        "aliases": {
          "Admin": "ExmentAdminCore\\Admin\\Facades\\Admin"
        }
      }
    },
    "config": {
      "process-timeout": 0
    }
}
